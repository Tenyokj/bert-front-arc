    "test:community-routing": "node --test scripts/community-reference.test.mjs",
    "sync:core-docs": "node scripts/sync-core-docs.mjs",
    "sync:v2-artifacts": "node scripts/sync-v2-artifacts.mjs",
    "sync:v3-artifact": "node scripts/sync-v3-community-artifact.mjs"
  },
  "dependencies": {
    "@worldcoin/idkit": "^4.2.2",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "^5.90.20",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "three": "^0.182.0",
    "viem": "2.57.11",
    "wagmi": "3.7.9",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.44.1",
    "viem@>=2.0.0 <3.0.0": "$viem",
    "abitype@>=1.0.0 <1.2.3": "1.2.3",
    "zod@>=4.0.0 <4.6.6": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "5.6.3"
  }
