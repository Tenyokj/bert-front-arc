{
  "name": "bert-v3-subgraph",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "sync:abis": "BERT_CORE_PATH=../../../bert-core V3_SUBGRAPH_ROOT=. node ../scripts/sync-v3-subgraph-artifacts.mjs",
    "configure": "node scripts/configure-manifest.mjs",
    "codegen": "npm run sync:abis && npm run configure && ../subgraph/node_modules/.bin/graph codegen subgraph.yaml",
    "build": "npm run codegen && ../subgraph/node_modules/.bin/graph build subgraph.yaml"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "overrides": {
    "decompress": "npm:@xhmikosr/decompress@11.1.4",
    "@graphprotocol/graph-cli": {
      "glob": "11.1.0",
      "immutable": "5.1.9",
      "js-yaml": "4.3.2",
      "undici": "7.30.1",
      "yaml": "2.9.1"
    },
    "gluegun": {
      "cross-spawn": "7.0.6",
      "ejs": "3.1.10",
      "semver": "7.7.3"
    },
    "brace-expansion@^2.0.0": "2.1.7"
  }
}
