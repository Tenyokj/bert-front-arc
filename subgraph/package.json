{
  "name": "bert-subgraph",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "codegen:local": "graph codegen subgraph.local.yaml",
    "build:local": "graph build subgraph.local.yaml",
    "create:local": "graph create --node http://127.0.0.1:8020 bert-local",
    "deploy:local": "graph deploy --version-label v0.0.1 --node http://127.0.0.1:8020 --ipfs http://127.0.0.1:5001/api/v0 bert-local subgraph.local.yaml",
    "codegen:arc": "graph codegen subgraph.yaml",
    "build:arc": "graph build subgraph.yaml",
    "test:security": "node --test scripts/toolchain-security.test.mjs"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "overrides": {
    "decompress": "npm:@xhmikosr/decompress@11.1.4",
    "@graphprotocol/graph-cli": {
      "glob": "11.1.0",
      "immutable": "5.1.9",
      "js-yaml": "4.3.2",
      "undici": "7.30.1",
      "yaml": "2.9.1"
    },
    "gluegun": {
      "cross-spawn": "7.0.6",
      "ejs": "3.1.10",
      "semver": "7.7.3"
    },
    "brace-expansion@^2.0.0": "2.1.7"
  }
}
